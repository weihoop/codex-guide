# Codex execpolicy relaxed rules for users who prefer fewer confirmations.
# Decisions: allow = run without another confirmation; prompt = ask first;
# forbidden = block. This profile allows network, package, container, and
# remote commands while still blocking irreversible machine-wide operations.

# -----------------------------------------------------------------------------
# Forbidden: irreversible or machine-wide destructive operations.
# -----------------------------------------------------------------------------
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden")
prefix_rule(pattern=["rm", "-fr", "/"], decision="forbidden")
prefix_rule(pattern=["rm", "-rf", "~"], decision="forbidden")
prefix_rule(pattern=["rm", "-fr", "~"], decision="forbidden")
prefix_rule(pattern=["sudo", "rm", "-rf", "/"], decision="forbidden")
prefix_rule(pattern=["sudo", "rm", "-fr", "/"], decision="forbidden")
prefix_rule(pattern=["sudo", "rm", "-rf", "~"], decision="forbidden")
prefix_rule(pattern=["sudo", "rm", "-fr", "~"], decision="forbidden")
prefix_rule(pattern=["dd"], decision="forbidden")
prefix_rule(pattern=["sudo", "dd"], decision="forbidden")
prefix_rule(pattern=["mkfs"], decision="forbidden")
prefix_rule(pattern=["sudo", "mkfs"], decision="forbidden")
prefix_rule(pattern=["diskutil", "eraseDisk"], decision="forbidden")
prefix_rule(pattern=["sudo", "diskutil", "eraseDisk"], decision="forbidden")

# -----------------------------------------------------------------------------
# Prompt: local destructive or privilege-changing operations.
# -----------------------------------------------------------------------------
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["rmdir"], decision="prompt")
prefix_rule(pattern=["sudo", "rm"], decision="prompt")
prefix_rule(pattern=["sudo", "rmdir"], decision="prompt")
prefix_rule(pattern=["shutdown"], decision="prompt")
prefix_rule(pattern=["reboot"], decision="prompt")
prefix_rule(pattern=["halt"], decision="prompt")
prefix_rule(pattern=["poweroff"], decision="prompt")
prefix_rule(pattern=["sudo", "shutdown"], decision="prompt")
prefix_rule(pattern=["sudo", "reboot"], decision="prompt")
prefix_rule(pattern=["sudo", "halt"], decision="prompt")
prefix_rule(pattern=["sudo", "poweroff"], decision="prompt")

prefix_rule(pattern=["docker", "system", "prune"], decision="prompt")
prefix_rule(pattern=["terraform", "destroy"], decision="prompt")
prefix_rule(pattern=["kubectl", "delete"], decision="prompt")

# -----------------------------------------------------------------------------
# Allow: common read-only inspection and local development verification.
# -----------------------------------------------------------------------------
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["command"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["chmod"], decision="allow")
prefix_rule(pattern=["chown"], decision="allow")
prefix_rule(pattern=["sudo"], decision="allow")

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "pull", "--ff-only"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "restore"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "reset"], decision="allow")
prefix_rule(pattern=["git", "rebase"], decision="allow")
prefix_rule(pattern=["git", "clean"], decision="allow")

prefix_rule(pattern=["npm", "test"], decision="allow")
prefix_rule(pattern=["npm", "run", "test"], decision="allow")
prefix_rule(pattern=["npm", "run", "lint"], decision="allow")
prefix_rule(pattern=["npm", "run", "build"], decision="allow")
prefix_rule(pattern=["npm", "run", "typecheck"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "i"], decision="allow")
prefix_rule(pattern=["pnpm", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "run", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "run", "lint"], decision="allow")
prefix_rule(pattern=["pnpm", "run", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "install"], decision="allow")
prefix_rule(pattern=["yarn", "test"], decision="allow")
prefix_rule(pattern=["yarn", "lint"], decision="allow")
prefix_rule(pattern=["yarn", "build"], decision="allow")
prefix_rule(pattern=["yarn", "install"], decision="allow")
prefix_rule(pattern=["bun", "test"], decision="allow")
prefix_rule(pattern=["bun", "run", "test"], decision="allow")
prefix_rule(pattern=["bun", "run", "lint"], decision="allow")
prefix_rule(pattern=["bun", "run", "build"], decision="allow")
prefix_rule(pattern=["bun", "install"], decision="allow")

prefix_rule(pattern=["python", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["python3", "-m", "pytest"], decision="allow")
prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["ruff", "check"], decision="allow")
prefix_rule(pattern=["ruff", "format", "--check"], decision="allow")
prefix_rule(pattern=["mypy"], decision="allow")
prefix_rule(pattern=["pip", "install"], decision="allow")
prefix_rule(pattern=["pip3", "install"], decision="allow")
prefix_rule(pattern=["uv", "add"], decision="allow")
prefix_rule(pattern=["uv", "pip", "install"], decision="allow")

prefix_rule(pattern=["go", "test"], decision="allow")
prefix_rule(pattern=["cargo", "test"], decision="allow")
prefix_rule(pattern=["cargo", "check"], decision="allow")
prefix_rule(pattern=["cargo", "clippy"], decision="allow")

prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["wget"], decision="allow")
prefix_rule(pattern=["ssh"], decision="allow")
prefix_rule(pattern=["scp"], decision="allow")
prefix_rule(pattern=["rsync"], decision="allow")
prefix_rule(pattern=["docker"], decision="allow")
prefix_rule(pattern=["docker-compose"], decision="allow")
prefix_rule(pattern=["kubectl"], decision="allow")
prefix_rule(pattern=["terraform"], decision="allow")
prefix_rule(pattern=["gh", "release"], decision="allow")
prefix_rule(pattern=["gh", "repo"], decision="allow")
